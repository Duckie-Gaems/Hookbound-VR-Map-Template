{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },

    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
	"*.txt": "lua"
    },

    "Lua.workspace.library": [
        "${workspaceFolder}/HookLua"
    ],

    "Lua.workspace.ignoreDir": [
        "Library",
        "Temp",
        "Obj",
        "Logs",
        "Packages",
        "ProjectSettings",
        "UserSettings",
        "Assets/Plugins",
        "Assets/StreamingAssets",
        "Assets/ThirdParty",
        "Assets/External",
        "Assets/UnityPackages",
        "Assets/TextMesh Pro"
    ],

    "Lua.runtime.version": "Lua 5.1",

"Lua.diagnostics.globals": [
    "Map",
    "Player",
    "System",
    "Interaction",
    "Grapple",
    "Log"
],
	  "Lua.diagnostics.disable": ["lowercase-global", "need-check-nil"],
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj"
    },

    "dotnet.defaultSolution": "Hookbound-VR-Map-Template.slnx"
}
